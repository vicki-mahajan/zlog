<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex align-items-center py-3 border-bottom-0">
           <div class="fw-bold"><%= @post.user.email.split('@').first %></div>
           <div class="ms-auto">
             <%= link_to "Back", posts_path, class: "btn btn-link text-decoration-none text-muted btn-sm" %>
           </div>
        </div>

        <% if @post.image.attached? %>
          <%= image_tag @post.image, class: "card-img rounded-0 w-100" %>
        <% end %>
        
        <div class="card-body">
          <div class="d-flex gap-3 mb-3">
             <i class="bi bi-heart fs-4"></i>
             <i class="bi bi-chat fs-4"></i>
             <i class="bi bi-send fs-4"></i>
          </div>

          <p class="card-text">
             <strong><%= @post.user.email.split('@').first %></strong> <%= @post.body %>
          </p>
          <div class="text-uppercase text-muted small mb-3">
            <%= time_ago_in_words(@post.created_at) %> ago
          </div>

          <hr class="my-3">

          <h6 class="fw-bold mb-3">
            Comments (<%= @post.comments.count %>)
          </h6>
          
          <div class="mb-4">
            <% @post.comments.includes(:user).order(created_at: :asc).each do |comment| %>
               <div class="mb-2">
                 <strong><%= comment.user.email.split('@').first %></strong> 
                 <%= comment.body %>
                 <span class="text-muted ms-2 small"><%= time_ago_in_words(comment.created_at) %></span>
               </div>
            <% end %>
          </div>

          <% if user_signed_in? %>
            <%= form_with(model: [@post, Comment.new], local: true, class: "d-flex gap-2") do |f| %>
              <%= f.text_field :body, class: "form-control form-control-sm rounded-pill bg-light border-0 px-3", placeholder: "Add a comment..." %>
              <%= f.submit "Post", class: "btn btn-link text-primary text-decoration-none fw-bold" %>
            <% end %>
          <% else %>
             <p class="text-center text-muted small">
               <%= link_to "Log in", new_user_session_path %> and join the conversation.
             </p>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>
