<div class="container py-5">
  <div class="card border shadow-sm p-4">
    <% if action_name == "dashboard" %>
      <h2 class="text-center fw-bold mb-4">Your Dashboard</h2>
    <% else %>
      <div class="text-center mb-5">
        <h2 class="fw-bold">Welcome to MiniBlog!</h2>
        <p class="text-muted fs-5">A simple blogging platform to share your thoughts.</p>
        <%= link_to "#{user_signed_in? ? 'Create Post' : 'Get Started'}", new_post_path, class: "btn btn-success mt-3 px-4 py-2" %>
      </div>
    <% end %>

    <div class="row g-4 justify-content-center">
      <% @posts.each do |post| %>
        <div class="col-md-8 col-lg-6">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center py-3 border-bottom-0">
               <div class="fw-bold"><%= post.user.email.split('@').first %></div>
               <% if user_signed_in? && post.user == current_user %>
                 <div class="ms-auto dropdown">
                   <button class="btn btn-link text-dark text-decoration-none p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                     ...
                   </button>
                   <ul class="dropdown-menu dropdown-menu-end">
                     <li><%= link_to "Edit", edit_post_path(post), class: "dropdown-item" %></li>
                     <li><%= link_to "Delete", post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "dropdown-item text-danger" %></li>
                   </ul>
                 </div>
               <% end %>
            </div>

            <% if post.image.attached? %>
              <%= image_tag post.image, class: "card-img rounded-0" %>
            <% end %>

            <div class="card-body">
              <div class="d-flex gap-3 mb-2">
                 <i class="bi bi-heart fs-4"></i>
                 <i class="bi bi-chat fs-4"></i>
                 <i class="bi bi-send fs-4"></i>
              </div>

              <p class="card-text mb-1">
                <strong><%= post.user.email.split('@').first %></strong> <%= post.body %>
              </p>

              <% if post.comments.any? %>
                <%= link_to "View all #{post.comments.count} comments", post_path(post), class: "text-muted text-decoration-none small" %>
              <% end %>

              <div class="text-uppercase text-muted" style="font-size: 0.75rem;">
                <%= time_ago_in_words(post.created_at) %> ago
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
