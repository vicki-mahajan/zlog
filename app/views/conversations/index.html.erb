<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Chats</h2>
    <%= link_to "New Chat", new_conversation_path, class: "btn btn-primary rounded-pill px-4" %>
  </div>
  <div class="card shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if @conversations.any? %>
        <div class="list-group list-group-flush">
          <% @conversations.each do |conversation| %>
            <% other = conversation.users.where.not(id: current_user.id).first %>
            <%= link_to conversation_path(conversation),
                        class: "list-group-item list-group-item-action py-3 d-flex align-items-center gap-3" do %>

              <i class="bi bi-person-circle fs-3"></i>

              <div class="flex-grow-1">
                <div class="fw-semibold">
                  <%= other.email.split('@').first %>
                </div>

                <div class="small text-muted">
                  <% if conversation.messages.any? %>
                    <%= truncate(conversation.messages.last.body, length: 50) %> —
                    <%= time_ago_in_words(conversation.messages.last.created_at) %> ago
                  <% else %>
                    No messages yet
                  <% end %>
                </div>
              </div>

            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="p-4 text-center text-muted">
          You have no conversations yet.  
          <br>
          <%= link_to "Start a new chat", new_conversation_path, class: "btn btn-sm btn-outline-primary mt-3" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
