<div class="container mt-4">
  <h2>Start New Chat</h2>
  <p class="text-muted mb-3">Select a user to begin chatting with them.</p>

  <ul class="list-group">
    <% @users.each do |user| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <i class="bi bi-person-circle"></i>
          <strong><%= user.email.split('@').first %></strong>
        </div>

        <% conversation = current_user.conversation_with(user) %>

        <% if conversation %>
          <%= link_to "Message",
                      conversation_path(conversation),
                      class: "btn btn-sm btn-secondary" %>
        <% else %>
          <%= button_to "Start Chat",
                        conversations_path(user_id: user.id),
                        method: :post,
                        class: "btn btn-sm btn-primary" %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="mt-3">
    <%= link_to "Back to Chats", conversations_path, class: "btn btn-sm btn-dark" %>
  </div>
</div>
